# Adapted from ad1822/hyprdots (MIT). Colours are in dunstrc.d/10-colors.conf (per theme).
[global]
    monitor = 0
    follow = none
    width = 300
    height = 130
    origin = top-center
    offset = "15x15"
    padding = 15
    horizontal_padding = 15
    gap_size = 8
    frame_width = 1
    corner_radius = 8
    progress_bar = true
    progress_bar_height = 7
    icon_position = left
    max_icon_size = 48
    markup = full
    font = "Inter 10"
    format = "<b>%s</b>\n%b"
    word_wrap = yes
    mouse_left_click = do_action
    mouse_middle_click = close_all
    mouse_right_click = close_current
    history_length = 20
