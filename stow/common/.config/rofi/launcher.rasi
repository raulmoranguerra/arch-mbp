/* Adapted from ad1822/hyprdots (MIT). Colours in colors.rasi. */
@import "colors.rasi"
configuration {
    modi: "drun,window";
    show-icons: true;
    display-drun: "";
    drun-display-format: "{name}";
}
* { font: "Iosevka Nerd Font 10"; }
window {
    transparency: "real";
    location: center;
    width: 420px;
    border-radius: 6px;
    background-color: @background;
}
mainbox { spacing: 0px; background-color: transparent; children: [ "inputbar", "listview" ]; }
inputbar { spacing: 8px; padding: 16px 16px 0px 16px; background-color: transparent; text-color: @foreground; children: [ "prompt", "entry" ]; }
prompt { padding: 10px 18px 10px 15px; border-radius: 6px; background-color: @accent; text-color: @on-accent; }
entry { padding: 10px 16px; border-radius: 6px; background-color: @background-alt; text-color: @foreground; placeholder: "Search"; placeholder-color: inherit; }
listview { padding: 8px; columns: 1; lines: 6; cycle: true; dynamic: true; scrollbar: false; spacing: 6px; margin: 16px 12px; background-color: transparent; text-color: @foreground; }
element { padding: 6px; border-radius: 6px; background-color: transparent; text-color: @foreground; }
element selected.normal { background-color: @accent; text-color: @on-accent; }
element-icon { background-color: transparent; text-color: inherit; size: 28px; }
element-text { padding: 0px 12px; background-color: transparent; text-color: inherit; vertical-align: 0.5; }
